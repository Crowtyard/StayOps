# StayOps 环境变量示例 — 复制为 .env 后填写真实值
# 注意：.env 已被 .gitignore 忽略，切勿提交真实凭据

# PostgreSQL
POSTGRES_DB=stayops
POSTGRES_USER=stayops
POSTGRES_PASSWORD=change-me

# 后端连接串（Sprint 1 使用）
DATABASE_URL=postgresql://stayops:change-me@localhost:5432/stayops

# 后端（FastAPI）
# BACKEND_PORT=8000

# 前端（Next.js）
# FRONTEND_PORT=3000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# JWT 签名密钥（生产必须更换）
SECRET_KEY=change-me-to-a-long-random-secret
